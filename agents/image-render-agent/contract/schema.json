{
  "type": "object",
  "required": ["canvas", "global", "rows", "validation"],

  "properties": {

    "canvas": {
      "type": "object",
      "properties": {
        "width": { "type": "integer" },
        "height": { "type": "integer" }
      },
      "required": ["width", "height"]
    },

    "global": {
      "type": "object",
      "properties": {
        "row_gap": { "type": "number" },
        "col_gap": { "type": "number" }
      }
    },

    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["row_index", "areas"],

        "properties": {

          "row_index": { "type": "integer" },
          "height_percent": { "type": "number" },
          "alignment": { "type": "string" },

          "areas": {
            "type": "array",
            "items": {
              "type": "object",

              "required": ["area_id", "area_name", "grid"],

              "properties": {

                "area_id": { "type": "string" },
                "area_name": { "type": "string" },
                "note": { "type": "string" },

                "width_percent": { "type": "number" },
                "x_percent": { "type": "number" },

                "grid": {
                  "type": "object",
                  "properties": {
                    "rows": { "type": "integer" },
                    "cols": { "type": "integer" }
                  },
                  "required": ["rows", "cols"]
                },

                "spaces": {
                  "type": "array",
                  "items": {
                    "type": "object",

                    "required": ["id", "row", "col_start"],

                    "properties": {
                      "id": { "type": "string" },
                      "row": { "type": "integer" },
                      "col_start": { "type": "integer" },
                      "col_span": { "type": "integer" },
                      "note": { "type": "string" }
                    }
                  }
                },

                "groups": {
                  "type": "array",
                  "items": {
                    "type": "object",

                    "required": ["start", "end"],

                    "properties": {
                      "start": { "type": "integer" },
                      "end": { "type": "integer" },
                      "note": { "type": "string" }
                    }
                  }
                }

              }
            }
          },

          "empty": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "width_percent": { "type": "number" }
              }
            }
          }

        }
      }
    },

    "validation": {
      "type": "object",

      "required": ["status"],

      "properties": {

        "status": { "type": "string" },

        "rows": {
          "type": "array",
          "items": {
            "type": "object",

            "required": ["row_index", "areas"],

            "properties": {

              "row_index": { "type": "integer" },

              "areas": {
                "type": "array",
                "items": {
                  "type": "object",

                  "required": ["area_id", "status"],

                  "properties": {
                    "area_id": { "type": "string" },
                    "space_width": { "type": "number" },
                    "space_height": { "type": "number" },
                    "status": { "type": "string" }
                  }
                }
              }

            }
          }
        }

      }
    }

  }
}
