{
  "version": "v1.0-min",

  "canvas": {
    "width": 1106,
    "height": 688,
    "background_color": "#FFFFFF"
  },

  "typography": {
    "font_family": "Segoe UI",
    "color": "#1F2D3D"
  },

  "area_header": {
    "position": "top_center",
    "font_size": 16,
    "font_weight": "bold",
    "format": "{area_name} ({area_note})"
  },

  "space_id": {
    "position": "top_center",
    "font_size": 14,
    "font_weight": "bold"
  },

  "space_note": {
    "position": "center",
    "font_size": 12
  },

  "group": {
    "position": "outside_top",
    "font_size": 13,
    "font_weight": "bold",
    "format": "{range} ({note})"
  },

  "border": {
    "color": "#000000",
    "width": 2,
    "style": "solid"
  },

  "background": {
    "area": "#f2ab2c",
    "space": "#f2ab2c"
  }
}